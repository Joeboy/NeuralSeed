@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://joebutton.co.uk/lv2/neuralseed#model>
    a lv2:Parameter ; mod:fileTypes "json" ;
    rdfs:label "NeuralSeed JSON Model" ; rdfs:range atom:Path .

<https://joebutton.co.uk/lv2/neuralseed>
    a lv2:Plugin , lv2:DistortionPlugin ;
    doap:name "NeuralSeed" ;
    lv2:requiredFeature urid:map ;
    patch:writable <https://joebutton.co.uk/lv2/neuralseed#model> ;
    lv2:port
      [ a lv2:InputPort , lv2:AudioPort ; lv2:index 0 ; lv2:symbol "input" ; lv2:name "Input" ] ,
      [ a lv2:OutputPort , lv2:AudioPort ; lv2:index 1 ; lv2:symbol "output" ; lv2:name "Output" ] ,
      [ a lv2:InputPort , atom:AtomPort ; atom:bufferType atom:Sequence ; atom:supports patch:Message ; lv2:designation lv2:control ; lv2:index 2 ; lv2:symbol "control" ; lv2:name "Control" ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 3 ; lv2:symbol "input_level" ; lv2:name "Input Level" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 3 ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 4 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 5 ; lv2:symbol "output_level" ; lv2:name "Output Level" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 6 ; lv2:symbol "param_1" ; lv2:name "Parameter 1" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 7 ; lv2:symbol "param_2" ; lv2:name "Parameter 2" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 8 ; lv2:symbol "param_3" ; lv2:name "Parameter 3" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 9 ; lv2:symbol "bypass" ; lv2:name "Bypass" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 10 ; lv2:symbol "eq_bass" ; lv2:name "Bass Boost" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 11 ; lv2:symbol "eq_low_mid" ; lv2:name "Low Mid Boost" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 12 ; lv2:symbol "eq_high_mid" ; lv2:name "High Mid Boost" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] ,
      [ a lv2:InputPort , lv2:ControlPort ; lv2:index 13 ; lv2:symbol "eq_treble" ; lv2:name "Treble Boost" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ] .
